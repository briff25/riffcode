# brianriffle.com on Pair Networks (Apache). Built by Next.js static export.

ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes

# Send every visitor to HTTPS (SSL enabled in the Pair control panel).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Old personal-site pages now live on the one-page site.
Redirect 301 /about.html           https://brianriffle.com/
Redirect 301 /about_page.html      https://brianriffle.com/
Redirect 301 /blog.html            https://brianriffle.com/
Redirect 301 /contact_form_website.html https://brianriffle.com/
Redirect 301 /thank_you_page.html  https://brianriffle.com/

# Vibe-coding projects moved to riffcode.brianriffle.com (carried over from the old .htaccess).
Redirect 301 /LicensePlate.html            https://riffcode.brianriffle.com/apps/license-plate/
Redirect 301 "/Fun with Math.html"         https://riffcode.brianriffle.com/apps/fun-with-math/
Redirect 301 /NextStepRetail.html          https://riffcode.brianriffle.com/apps/next-step-retail/
Redirect 301 /RetailLayoutStudio           https://riffcode.brianriffle.com/apps/retail-layout-studio
Redirect 301 /RetailLayoutCreator2         https://riffcode.brianriffle.com/apps/retail-layout-creator-2

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Next.js puts content-hashed files under /_next/static, so they never change.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
